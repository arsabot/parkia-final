# Mapas Carto
VITE_CARTO_API_KEY=your-carto-api-key

# Backend Django (Opcional - Desarrollo local)
VITE_API_URL=http://127.0.0.1:8000/api

# Supabase (Modo Serverless 100% en la Nube - Sin necesidad de levantar backend)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Inteligencia Artificial (Opcional - Google Gemini para recomendaciones conversacionales avanzadas en el Chatbot)
# Si no se define, ParkIA utiliza su motor de recomendación inteligente contextual integrado.
VITE_GEMINI_API_KEY=tu-api-key-de-gemini-aqui

# Formulario de Contacto (web3forms.com – crear una clave con el correo del equipo)
VITE_WEB3FORMS_KEY=tu-access-key-aqui

# Mail de agradecimiento al usuario (emailjs.com – opcional)
VITE_EMAILJS_SERVICE_ID=tu-service-id
VITE_EMAILJS_TEMPLATE_ID=tu-template-id
VITE_EMAILJS_PUBLIC_KEY=tu-public-key
